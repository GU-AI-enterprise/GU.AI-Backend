# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Credentials
# Lấy SUPABASE_URL tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=your_supabase_project_url

# Lấy SUPABASE_ANON_KEY tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon, public)
SUPABASE_ANON_KEY=your_supabase_anon_key

# (Optional) Service Role Key: Dùng cho các tác vụ admin (không check RLS).
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role, secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# (Optional) Password cho direct DB connection
SUPABASE_DB_PASS=your_db_password

# Client URL (Dùng cho CORS và OAuth Redirect) — danh sách origin cách nhau bởi dấu phẩy.
# Nếu để trống, mặc định cho phép: localhost:3000, guai.com.vn, www.guai.com.vn, admin.guai.com.vn
CLIENT_URL=http://localhost:3000,https://guai.com.vn,https://www.guai.com.vn,https://admin.guai.com.vn

# Fashn.ai API Key
# Lấy tại: https://fashn.ai → Dashboard → API Keys
FASHN_API_KEY=AlzaSyBTnquzVRBraQqkK-9ftYBay2NpbnhkA

# PayOS Payment Gateway
# Lấy tại: https://my.payos.vn → Thông tin tích hợp
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

GEMINI_API_KEY=your_gemini_api_key

# Resend (primary email provider)
# Lấy tại: resend.com → API Keys → Create API Key
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=GU.AI <noreply@guai.com.vn>

APP_URL=http://localhost:3000
