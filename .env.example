# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Credentials
# Lấy SUPABASE_URL tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=your_supabase_project_url

# Lấy SUPABASE_ANON_KEY tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon, public)
SUPABASE_ANON_KEY=your_supabase_anon_key

# (Optional) Service Role Key: Dùng cho các tác vụ admin (không check RLS).
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role, secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# (Optional) Password cho direct DB connection
SUPABASE_DB_PASS=your_db_password

# Client URL (Dùng cho CORS và OAuth Redirect)
# Thay đổi thành URL frontend của bạn (VD: http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Fashn.ai API Key
# Lấy tại: https://fashn.ai → Dashboard → API Keys
FASHN_API_KEY=AlzaSyBTnquzVRBraQqkK-9ftYBay2NpbnhkA
