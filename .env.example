# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Credentials
# Lấy SUPABASE_URL tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=your_supabase_project_url

# Lấy SUPABASE_ANON_KEY tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon, public)
SUPABASE_ANON_KEY=your_supabase_anon_key

# (Optional) Service Role Key: Dùng cho các tác vụ admin (không check RLS). 
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role, secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# (Optional) Password cho direct DB connection
SUPABASE_DB_PASS=your_db_password

# Client URL (Dùng cho CORS và OAuth Redirect)
# Thay đổi thành URL frontend của bạn (VD: http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Gemini AI API Keys (up to 4 keys for rotation/fallback when quota exhausted)
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=AIzaSy...
GEMINI_API_KEY_2=AIzaSy...
GEMINI_API_KEY_3=AIzaSy...
GEMINI_API_KEY_4=AIzaSy...

# Gemini Model (default: gemini-2.5-flash-image = Nano Banana stable)
# Options: gemini-2.5-flash-image (stable), gemini-3.1-flash-image-preview (Nano Banana 2), gemini-3-pro-image-preview (Pro, 4K)
GEMINI_MODEL=gemini-2.5-flash-image
